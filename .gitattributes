# Normalize line endings: LF in the repository and working tree on every OS.
# Prevents Windows checkouts from breaking shell scripts, Docker builds and CI diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.jar  binary
