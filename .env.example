# Copy this file to `.env` in the repository root and fill in values.
# `.env` is git-ignored. Never commit real secrets.

# ── PostgreSQL (used by docker-compose.yml and the backend) ──
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# ── Backend ──
# JDBC URL the Spring Boot app connects to
NOVA_DB_URL=jdbc:postgresql://localhost:5432/nova
NOVA_DB_USER=nova
NOVA_DB_PASSWORD=change-me-locally
# Comma-separated origins allowed by CORS (dev only; production is same-origin via the /api proxy)
NOVA_CORS_ORIGINS=http://localhost:5173
# Set to true in production (HTTPS) so the session cookie gets the Secure flag
NOVA_COOKIE_SECURE=false
# Shared secret the website's proxy sends with every API call (header X-Nova-Proxy-Secret). Leave
# empty for `npm run dev` + `mvnw spring-boot:run`. Required by the prod profile and the Docker
# backend (`docker compose --profile app up`): at least 32 random characters, e.g.
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   bash:       openssl rand -hex 24
# Vite's dev and preview servers add it automatically when it is set here.
NOVA_PROXY_SECRET=
# "Try the demo": temporary accounts with fictional data, deleted after 24 hours (true/false)
NOVA_DEMO_ENABLED=true
# Optional GitHub token for public data. Leave empty: profiles and repositories still work
# (60 requests/hour); the contribution calendar needs a token. Create a fine-grained personal
# access token with no extra permissions. Never commit a real one.
GITHUB_SERVER_TOKEN=

# ── Frontend ──
# Set to true to run the frontend against in-browser mock APIs (no backend needed)
VITE_API_MOCKS=false
# Public GitHub URL shown on the landing page (leave empty to hide the link)
VITE_REPO_URL=
